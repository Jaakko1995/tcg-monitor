# Kopioi tämä tiedostoksi .env.
# WEBHOOK_URL         = ajokuittaukset ("Ajo valmis", siemennys, virheet)
# WEBHOOK_ALERTS_URL  = tuotemuutokset (uusi tuote / takaisin varastossa / hinta / ennakko)
#                       Jos tyhjä -> kaikki menee WEBHOOK_URL:iin.
WEBHOOK_URL=https://example.invalid/webhook/xxxx/yyyy
WEBHOOK_ALERTS_URL=
